//@version=6
strategy("RSI MA Cross 30-70 Research", "RSI Cross BT", overlay = true, initial_capital = 10000, currency = currency.USD, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, pyramiding = 0, commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 10, margin_long = 100, margin_short = 100, process_orders_on_close = false, calc_on_order_fills = false, calc_on_every_tick = false, use_bar_magnifier = false)
// Entry has ONLY RSI/SMA crossover and contemporaneous RSI threshold.
// Confirmed pivots are execution risk anchors, NOT entry confirmations.
startTime = input.time(timestamp("21 Jul 2026 00:00 +0000"), "Start UTC")
endTime = input.time(timestamp("19 Oct 2026 00:00 +0000"), "End UTC")
rsiLength = input.int(14, "RSI period", minval = 1)
maLength = input.int(14, "RSI SMA period", minval = 1)
lower = input.float(30, "Long RSI below", minval = 0, maxval = 100)
upper = input.float(70, "Short RSI above", minval = 0, maxval = 100)
pivotLength = input.int(2, "Risk pivot length (stop only)", minval = 1)
plannedR = input.float(2, "Planned reward / risk", minval = 0.1)
rsi = ta.rsi(close, rsiLength)
ma = ta.sma(rsi, maLength)
crossUp = ta.crossover(rsi, ma)
crossDown = ta.crossunder(rsi, ma)
longSignal = barstate.isconfirmed and crossUp and rsi < lower
shortSignal = barstate.isconfirmed and crossDown and rsi > upper
ph = ta.pivothigh(high, pivotLength, pivotLength)
pl = ta.pivotlow(low, pivotLength, pivotLength)
var float riskHigh = na
var float riskLow = na
var float stopPrice = na
var float targetPrice = na
var int firstLoaded = time
var int bars = 0
var int longSignals = 0
var int shortSignals = 0
var int longEntries = 0
var int shortEntries = 0
var int invalidStops = 0
var int busySignals = 0
inWindow = time >= startTime and time_close < endTime
if barstate.isconfirmed
    if inWindow
        bars += 1
        if longSignal
            longSignals += 1
        if shortSignal
            shortSignals += 1
        if strategy.position_size != 0 and (longSignal or shortSignal)
            busySignals += 1
        if strategy.position_size == 0
            if longSignal
                if not na(riskLow) and riskLow - syminfo.mintick < close
                    stopPrice := riskLow - syminfo.mintick
                    targetPrice := close + plannedR * (close - stopPrice)
                    strategy.entry("Long", strategy.long)
                    strategy.exit("Long bracket", "Long", stop = stopPrice, limit = targetPrice)
                    longEntries += 1
                else
                    invalidStops += 1
            else if shortSignal
                if not na(riskHigh) and riskHigh + syminfo.mintick > close
                    stopPrice := riskHigh + syminfo.mintick
                    targetPrice := close - plannedR * (stopPrice - close)
                    if targetPrice > 0
                        strategy.entry("Short", strategy.short)
                        strategy.exit("Short bracket", "Short", stop = stopPrice, limit = targetPrice)
                        shortEntries += 1
                    else
                        invalidStops += 1
                else
                    invalidStops += 1
    if strategy.position_size > 0
        strategy.exit("Long bracket", "Long", stop = stopPrice, limit = targetPrice)
    if strategy.position_size < 0
        strategy.exit("Short bracket", "Short", stop = stopPrice, limit = targetPrice)
    if time_close >= endTime
        strategy.cancel_all()
        strategy.close_all(comment = "Window end", immediately = true)
    // Update only after decisions, preserving prior-confirmed risk anchors.
    if not na(ph)
        riskHigh := ph
    if not na(pl)
        riskLow := pl
plotshape(inWindow and longSignal, "Long RSI cross", shape.triangleup, location.belowbar, color.green, text = "L", size = size.tiny)
plotshape(inWindow and shortSignal, "Short RSI cross", shape.triangledown, location.abovebar, color.red, text = "S", size = size.tiny)
plot(strategy.position_size != 0 ? stopPrice : na, "Stop", color.red, style = plot.style_linebr)
plot(strategy.position_size != 0 ? targetPrice : na, "Target", color.green, style = plot.style_linebr)
plot(rsi, "RSI", display = display.data_window)
plot(ma, "RSI SMA", display = display.data_window)
var table stats = table.new(position.top_right, 2, 11, bgcolor = color.white)
if barstate.islastconfirmedhistory or barstate.islast
    table.cell(stats, 0, 0, "First loaded UTC", text_color = color.black)
    table.cell(stats, 1, 0, str.format_time(firstLoaded, "yyyy-MM-dd", "UTC"), text_color = color.black)
    table.cell(stats, 0, 1, "Window bars", text_color = color.black)
    table.cell(stats, 1, 1, str.tostring(bars), text_color = color.black)
    table.cell(stats, 0, 2, "Signals Long / Short", text_color = color.black)
    table.cell(stats, 1, 2, str.tostring(longSignals) + " / " + str.tostring(shortSignals), text_color = color.black)
    table.cell(stats, 0, 3, "Entries Long / Short", text_color = color.black)
    table.cell(stats, 1, 3, str.tostring(longEntries) + " / " + str.tostring(shortEntries), text_color = color.black)
    table.cell(stats, 0, 4, "Invalid stops / Busy signals", text_color = color.black)
    table.cell(stats, 1, 4, str.tostring(invalidStops) + " / " + str.tostring(busySignals), text_color = color.black)
    table.cell(stats, 0, 5, "Closed / Open trades", text_color = color.black)
    table.cell(stats, 1, 5, str.tostring(strategy.closedtrades) + " / " + str.tostring(strategy.opentrades), text_color = color.black)
    table.cell(stats, 0, 6, "Net P/L USD", text_color = color.black)
    table.cell(stats, 1, 6, str.tostring(strategy.netprofit, "#.##"), text_color = color.black)
    table.cell(stats, 0, 7, "Win rate %", text_color = color.black)
    table.cell(stats, 1, 7, strategy.closedtrades > 0 ? str.tostring(100.0 * strategy.wintrades / strategy.closedtrades, "#.##") : "N/A", text_color = color.black)
    table.cell(stats, 0, 8, "Profit factor", text_color = color.black)
    table.cell(stats, 1, 8, strategy.grossloss != 0 ? str.tostring(strategy.grossprofit / math.abs(strategy.grossloss), "#.###") : "N/A", text_color = color.black)
    table.cell(stats, 0, 9, "Max DD USD", text_color = color.black)
    table.cell(stats, 1, 9, str.tostring(strategy.max_drawdown, "#.##"), text_color = color.black)
    table.cell(stats, 0, 10, "Winning / Losing", text_color = color.black)
    table.cell(stats, 1, 10, str.tostring(strategy.wintrades) + " / " + str.tostring(strategy.losstrades), text_color = color.black)
